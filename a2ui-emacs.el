;;; Commentary:

;; A catalog of components that map an agent's intent onto things Emacs
;; already does well:
;;
;; - Section: a fold, toggled with RET or TAB on its heading
;; - Table: rows from the data model, with selection and a row action
;; - Diff: a unified diff fontified by `diff-mode', with Accept/Reject,
;;   hunk selection and Ediff
;; - Code: source fontified by the language's major mode
;; - Picker: one choice by completion, options from the data model
;; - FileRef: a link that visits a file at a line
;; - OrgText: Org markup with Org's faces
;; - Progress and Sparkline: a bar and a one-line chart, in a tone
;;
;; Diff can also let the user pick hunks and edit the change in Ediff,
;; and Table cells can carry a tone or draw numbers as bars and
;; sparklines.
;; The catalog is a superset of the basic catalog, so a surface can mix
;; Text and Button with these under one id, `a2ui-emacs-catalog-id'.
;; Its JSON Schema is catalogs/emacs/catalog.json, generated by
;; scripts/build-emacs-catalog.py.  Loading this file adds it to
;; `a2ui-default-catalogs', so new sessions advertise it.

;;; Code:

(require 'cl-lib)
(require 'subr-x)
(require 'diff)
(require 'a2ui-core)
(require 'a2ui-vui)

(defconst a2ui-emacs-catalog-id "https://github.com/chazu/a2ui.el/catalogs/emacs/v0.1"
  "Catalog id of the a2ui.el Emacs catalog.")

(defcustom a2ui-emacs-language-modes
  '(("elisp" . emacs-lisp-mode) ("emacs-lisp" . emacs-lisp-mode) ("lisp" . lisp-mode)
    ("python" . python-mode) ("py" . python-mode) ("js" . js-mode) ("javascript" . js-mode)
    ("ts" . typescript-ts-mode) ("typescript" . typescript-ts-mode) ("json" . js-json-mode)
    ("sh" . sh-mode) ("bash" . sh-mode) ("shell" . sh-mode) ("c" . c-mode) ("cpp" . c++-mode)
    ("go" . go-ts-mode) ("rust" . rust-ts-mode) ("ruby" . ruby-mode) ("java" . java-mode)
    ("css" . css-mode) ("html" . mhtml-mode) ("xml" . nxml-mode) ("sql" . sql-mode)
    ("yaml" . yaml-ts-mode) ("toml" . conf-toml-mode) ("diff" . diff-mode)
    ("org" . org-mode) ("markdown" . markdown-mode) ("make" . makefile-mode))
  "Major modes that fontify Code components, by language name.
A language not listed tries LANGUAGE-mode, but only a major mode
derived from `prog-mode', `text-mode' or `conf-mode' is ever used, so
an agent cannot switch on an arbitrary minor mode."
  :type '(alist :key-type string :value-type function)
  :group 'a2ui)

(defface a2ui-emacs-section-heading '((t :inherit (outline-2 bold)))
  "Face for Section headings." :group 'a2ui)

(defface a2ui-emacs-file '((t :inherit bold))
  "Face for the file name above a Diff." :group 'a2ui)

(defface a2ui-emacs-selected '((t :inherit highlight))
  "Face for selected Table rows." :group 'a2ui)

(defface a2ui-emacs-bar-empty '((t :inherit shadow))
  "Face for the empty part of a bar." :group 'a2ui)

(defface a2ui-emacs-hunk-off '((t :inherit shadow))
  "Face for Diff hunks the user has left out." :group 'a2ui)

(defcustom a2ui-emacs-bar-width 20
  "Width in characters of a Progress bar."
  :type 'natnum
  :group 'a2ui)

(defcustom a2ui-emacs-table-bar-width 8
  "Width in characters of a bar in a Table cell."
  :type 'natnum
  :group 'a2ui)

;;;; Fontification

(defvar a2ui-emacs--fontify-cache (make-hash-table :test 'equal)
  "(MODE . TEXT) -> fontified string; cleared when it grows large.")

(defun a2ui-emacs--mode-for (language)
  "Return the major mode for LANGUAGE, or nil when there is none to trust."
  (let* ((name (downcase (or language "")))
         (mode (or (cdr (assoc name a2ui-emacs-language-modes))
                   (intern-soft (concat name "-mode")))))
    (when (and mode (fboundp mode)
               (or (assoc name a2ui-emacs-language-modes)
                   ;; One parent per call: the signature differs across versions.
                   (seq-some (lambda (parent) (provided-mode-derived-p mode parent))
                             '(prog-mode text-mode conf-mode))))
      mode)))

(defun a2ui-emacs-fontify (text mode &optional setup strip-invisible)
  "Return TEXT fontified as MODE does, with `face' properties.
Mode hooks are not run, so a user's language servers and the like
stay out of it.  SETUP, a function, runs in the buffer before
fontifying.  With STRIP-INVISIBLE, text the mode hides (Org's
emphasis markers and link targets) is removed."
  (if (not mode)
      text
    (let ((key (list mode setup strip-invisible text)))
      (or (gethash key a2ui-emacs--fontify-cache)
          (let ((result
                 (with-temp-buffer
                   (insert text)
                   (condition-case nil
                       (progn
                         (delay-mode-hooks (funcall mode))
                         (when setup (funcall setup))
                         (font-lock-ensure)
                         (when strip-invisible
                           ;; Only what the mode really hides (Org 9.6 marks link
                           ;; descriptions with a visible `invisible' value), found
                           ;; before deleting: Org's change hooks would unhide the rest.
                           (let ((pos (point-min)) (hidden nil) (inhibit-modification-hooks t))
                             (while (< pos (point-max))
                               (let ((next (next-single-char-property-change pos 'invisible nil (point-max))))
                                 (when (invisible-p pos) (push (cons pos next) hidden))
                                 (setq pos next)))
                             (pcase-dolist (`(,beg . ,end) hidden) (delete-region beg end))))
                         ;; Some modes use `font-lock-face'; vui only keeps `face'.
                         (let ((pos (point-min)))
                           (while (< pos (point-max))
                             (let ((next (next-single-property-change pos 'font-lock-face nil (point-max)))
                                   (face (get-text-property pos 'font-lock-face)))
                               (when face (add-face-text-property pos next face t))
                               (setq pos next))))
                         (buffer-string))
                     (error text)))))
            (when (> (hash-table-count a2ui-emacs--fontify-cache) 200)
              (clrhash a2ui-emacs--fontify-cache))
            (puthash key result a2ui-emacs--fontify-cache))))))

;;;; Local state

(defun a2ui-emacs--run-action (surface component prop scope)
  "Run the action in PROP of COMPONENT on SURFACE, resolving in SCOPE.
The action is sent as coming from COMPONENT."
  (when-let* ((action (gethash prop component)))
    (a2ui-dispatch-action surface (a2ui-obj "id" (gethash "id" component) "action" action) scope)))

;;;; Gauges

(defun a2ui-emacs--fraction (value lo hi)
  "Return where VALUE lies between LO and HI, from 0.0 to 1.0."
  (if (> hi lo) (max 0.0 (min 1.0 (/ (float (- value lo)) (- hi lo)))) 0.0))

(defun a2ui-emacs-bar (fraction width &optional face)
  "Return a bar WIDTH cells wide, filled to FRACTION (0 to 1) in FACE."
  (let ((filled (round (* width (max 0.0 (min 1.0 (float fraction)))))))
    (concat (propertize (make-string filled ?█) 'face face)
            (propertize (make-string (- width filled) ?░) 'face 'a2ui-emacs-bar-empty))))

(defun a2ui-emacs-sparkline (values &optional lo hi face)
  "Return a one-line chart of VALUES, oldest first, in FACE.
Elements that are not numbers leave a gap.  LO and HI default to the
least and greatest of the numbers."
  (let* ((values (append values nil))
         (numbers (seq-filter #'numberp values))
         (lo (or lo (and numbers (apply #'min numbers)) 0))
         (hi (or hi (and numbers (apply #'max numbers)) 0))
         (glyphs "▁▂▃▄▅▆▇█"))
    (propertize
     (mapconcat (lambda (v)
                  (cond ((not (numberp v)) " ")
                        ((<= hi lo) (string (aref glyphs 3)))
                        (t (string (aref glyphs (min 7 (floor (* 8 (a2ui-emacs--fraction v lo hi)))))))))
                values "")
     'face face)))

(defun a2ui-emacs--number-prop (c prop surface scope)
  "Return PROP of C on SURFACE in SCOPE as a number, or nil."
  (a2ui-number (a2ui-resolve-prop c prop surface scope)))

(defun a2ui-emacs--tone (c surface scope)
  "Return the face for C's tone on SURFACE in SCOPE, or nil."
  (a2ui-vui-tone-face (a2ui-resolve-prop c "tone" surface scope)))

(defun a2ui-emacs--gauge-line (c surface scope gauge default)
  "Return C's label, GAUGE, then its text or DEFAULT, on one line.
SURFACE and SCOPE are where C's props resolve."
  (let ((text (a2ui-vui--string c "text" surface scope)))
    (vui-hstack
     (a2ui-vui--label-prefix c surface scope)
     (vui-text gauge)
     (vui-text (if (string-empty-p text) default text)))))

;;;; Components

(a2ui-define-component emacs "Section" (c surface scope)
  (let* ((path (a2ui-binding-path c "collapsed" scope))
         (key (a2ui-vui-key c scope))
         (collapsed (if path
                        (a2ui-true-p (a2ui-get surface path))
                      (a2ui-vui-local surface key
                                         (a2ui-true-p (a2ui-resolve-prop c "collapsed" surface scope)))))
         (toggle (lambda ()
                   (interactive)
                   (if path
                       (a2ui-vui--write surface path (a2ui-bool (not collapsed)))
                     (a2ui-vui-set-local surface key (not collapsed))))))
    (vui-vstack
     (vui-button (concat (if collapsed "▸ " "▾ ") (a2ui-vui--string c "title" surface scope))
       :key key
       :no-decoration t
       :face 'a2ui-emacs-section-heading
       :keymap (define-keymap "TAB" toggle "<tab>" toggle)
       :help-echo "RET or TAB: fold or unfold"
       :on-click toggle)
     (unless collapsed
       (vui-vstack :indent 2
                   (let ((a2ui-vui--indent (+ a2ui-vui--indent 2)))
                     (a2ui-vui-render surface (gethash "child" c) scope)))))))

(defun a2ui-emacs--rows (c surface scope)
  "Return (ROWS . BASE) for Table C on SURFACE in SCOPE.
ROWS is the row vector and BASE its data path, nil when the rows are
a literal rather than bound."
  (let ((value (a2ui-resolve-prop c "rows" surface scope)))
    (cons (if (vectorp value) value [])
          (a2ui-binding-path c "rows" scope))))

(defun a2ui-emacs--row-id (c row index)
  "Return the identity of ROW at INDEX in Table C: its rowKey field or INDEX."
  (let ((field (gethash "rowKey" c)))
    (if (and (stringp field) (hash-table-p row))
        (gethash field row)
      index)))

(a2ui-define-component emacs "Table" (c surface scope)
  (pcase-let* ((`(,rows . ,base) (a2ui-emacs--rows c surface scope))
               (columns (cl-remove-if-not #'hash-table-p (append (gethash "columns" c) nil)))
               (mode (or (gethash "selectable" c) "none"))
               (sel-path (a2ui-binding-path c "selection" scope))
               (selection (and sel-path (a2ui-get surface sel-path)))
               (selected (if (vectorp selection) (append selection nil) (and selection (list selection))))
               (action (gethash "rowAction" c))
               (key (a2ui-vui-key c scope)))
    (vui-table
     :key key
     :columns (append
               (unless (equal mode "none") (list (list :header "" :width 3)))
               (mapcar (lambda (col)
                         (list :header (a2ui-vui--string col "label" surface scope)
                               :align (pcase (gethash "align" col)
                                        ("right" :right) ("center" :center) (_ :left))))
                       columns))
     :rows
     (cl-loop
      for row across rows for index from 0
      collect
      ;; Fresh bindings per row: `cl-loop' variables are shared by
      ;; every closure made in the loop.
      (let* ((i index)
             (row-scope (and base (format "%s/%d" (string-remove-suffix "/" base) i)))
             (id (a2ui-emacs--row-id c row i))
             (on (member id selected)))
      (append
       (unless (equal mode "none")
         (list (vui-button (if (equal mode "single") (if on "(•)" "( )") (if on "[X]" "[ ]"))
                 :key (format "%s/select/%d" key i)
                 :no-decoration t
                 :on-click (lambda ()
                             (when sel-path
                               (a2ui-vui--write
                                surface sel-path
                                (if (equal mode "single")
                                    (if on nil id)
                                  (vconcat (if on (remove id selected) (append selected (list id)))))))))))
       (cl-loop
        for col in columns for first = t then nil
        for tone = (a2ui-emacs--cell-tone col row)
        for text = (a2ui-emacs--cell col row tone)
        collect (cond
                 ((and first action)
                  (vui-button text
                    :key (format "%s/row/%d" key i)
                    :no-decoration t
                    :face (cond (on 'a2ui-emacs-selected) (tone) (t 'a2ui-link))
                    :on-click (lambda () (a2ui-emacs--run-action surface c "rowAction" row-scope))))
                 (on (propertize (substring-no-properties text) 'face 'a2ui-emacs-selected))
                 (t text)))))))))

(defun a2ui-emacs--cell-tone (column row)
  "Return the face of ROW's cell in COLUMN, from the column's toneKey."
  (let ((field (gethash "toneKey" column)))
    (and (stringp field) (hash-table-p row)
         (a2ui-vui-tone-face (gethash field row)))))

(defun a2ui-emacs--cell (column row face)
  "Return the text of ROW's cell in COLUMN, in FACE.
A bar or sparkline column draws its numbers; anything else is text."
  (let ((value (and (hash-table-p row) (a2ui-pointer-get row (or (gethash "key" column) ""))))
        (lo (a2ui-number (gethash "min" column)))
        (hi (a2ui-number (gethash "max" column))))
    (pcase (gethash "display" column)
      ((and "bar" (guard (numberp value)))
       (a2ui-emacs-bar (a2ui-emacs--fraction value (or lo 0) (or hi 1)) a2ui-emacs-table-bar-width face))
      ((and "sparkline" (guard (vectorp value)))
       (a2ui-emacs-sparkline value lo hi face))
      (_ (let ((text (a2ui-stringify value)))
           (if face (propertize text 'face face) text))))))

;;;;; Diff

(defun a2ui-emacs-diff-hunks (diff)
  "Split unified DIFF into (HEADER . HUNKS), each a list of lines.
HEADER holds the lines before the first hunk; each hunk starts with
its @@ line."
  (let ((header nil) (hunks nil))
    (dolist (line (split-string (string-trim-right diff "\n+") "\n"))
      (cond ((string-prefix-p "@@" line) (push (list line) hunks))
            (hunks (push line (car hunks)))
            (t (push line header))))
    (cons (nreverse header) (nreverse (mapcar #'reverse hunks)))))

(defun a2ui-emacs--hunk-start (hunk)
  "Return the old file's start line and line count from HUNK's @@ line."
  (if (string-match "\\`@@ -\\([0-9]+\\)\\(?:,\\([0-9]+\\)\\)?" (car hunk))
      (cons (string-to-number (match-string 1 (car hunk)))
            (if (match-string 2 (car hunk)) (string-to-number (match-string 2 (car hunk))) 1))
    (signal 'a2ui-error (list (format "Not a hunk header: %s" (car hunk))))))

(defun a2ui-emacs--hunk-side (hunk keep)
  "Return HUNK's lines whose prefix is in KEEP, without the prefix."
  (let (out)
    (dolist (line (cdr hunk))
      (cond ((and (> (length line) 0) (memq (aref line 0) keep))
             (push (substring line 1) out))
            ;; Some tools write an empty context line as nothing at all.
            ((and (equal line "") (memq ?\s keep))
             (push "" out))))
    (nreverse out)))

(defun a2ui-emacs--find-lines (lines needle near)
  "Return the index in vector LINES where list NEEDLE starts, nearest NEAR."
  (let ((n (length needle)) (size (length lines)))
    (cl-flet ((at (i) (and (<= 0 i) (<= (+ i n) size)
                           (cl-loop for line in needle for j from i
                                    always (equal line (aref lines j))))))
      (cl-loop for d from 0 to (max near (- size near))
               thereis (cond ((at (- near d)) (- near d))
                             ((at (+ near d)) (+ near d)))))))

(defun a2ui-emacs-diff-apply (text diff &optional selected)
  "Return TEXT with the hunks of unified DIFF applied.
SELECTED, a list of hunk indices from 0, applies only those; nil
applies them all.  A hunk whose lines are not in TEXT signals an
`a2ui-error'."
  (let ((lines (vconcat (split-string text "\n")))
        (offset 0))
    (cl-loop
     for hunk in (cdr (a2ui-emacs-diff-hunks diff)) for index from 0
     when (or (null selected) (memq index selected))
     do (pcase-let* ((`(,start . ,count) (a2ui-emacs--hunk-start hunk))
                     (old (a2ui-emacs--hunk-side hunk '(?\s ?-)))
                     (new (a2ui-emacs--hunk-side hunk '(?\s ?+)))
                     (expected (+ offset (if (zerop count) start (1- start))))
                     (at (a2ui-emacs--find-lines lines old (max 0 expected))))
          (unless at
            (signal 'a2ui-error (list (format "Hunk %d does not apply: %s" (1+ index) (car hunk)))))
          (setq lines (vconcat (seq-subseq lines 0 at) new (seq-subseq lines (+ at (length old))))
                offset (+ offset (- at expected) (- (length new) (length old))))))
    (mapconcat #'identity lines "\n")))

(defun a2ui-emacs-unified-diff (old new file)
  "Return a unified diff from text OLD to text NEW of FILE, or \"\"."
  (let ((a (make-temp-file "a2ui-old")) (b (make-temp-file "a2ui-new")))
    (unwind-protect
        (let ((coding-system-for-write 'utf-8-unix)
              (coding-system-for-read 'utf-8-unix))
          (write-region old nil a nil 'silent)
          (write-region new nil b nil 'silent)
          (with-temp-buffer
            (let ((status (call-process diff-command nil t nil "-u"
                                        "--label" (concat "a/" file) "--label" (concat "b/" file) a b)))
              (unless (memq status '(0 1))
                (signal 'a2ui-error (list (format "diff failed: %s" (string-trim (buffer-string))))))
              (buffer-string))))
      (delete-file a)
      (delete-file b))))

(defun a2ui-emacs--diff-selection (c surface scope count)
  "Return the selected hunk indices of Diff C on SURFACE in SCOPE.
Return nil when C has no selection; unset means all COUNT hunks."
  (when-let* ((path (a2ui-binding-path c "selection" scope)))
    (let ((value (a2ui-get surface path)))
      (if (vectorp value)
          (seq-filter #'integerp (append value nil))
        (number-sequence 0 (1- count))))))

(defun a2ui-emacs--diff-file (surface file)
  "Return FILE of SURFACE's session as an absolute name when it exists."
  (unless (string-empty-p file)
    (let ((path (expand-file-name file (or (a2ui-session-directory (a2ui-surface-session surface))
                                           default-directory))))
      (and (file-regular-p path) path))))

(defun a2ui-emacs--diff-buttons (c surface scope &optional path hunks)
  "Return the buttons of Diff C on SURFACE in SCOPE, or nil.
PATH, the file's absolute name, offers Ediff.  HUNKS is (SELECTED
. COUNT) when the user picks hunks."
  (let* ((key (a2ui-vui-key c scope))
         (buttons
          (delq nil
                (list (when (gethash "acceptAction" c)
                        (vui-button "Accept"
                          :key (concat key "/accept")
                          :face 'a2ui-button-primary
                          :on-click (lambda () (a2ui-emacs--run-action surface c "acceptAction" scope))))
                      (when (gethash "rejectAction" c)
                        (vui-button "Reject"
                          :key (concat key "/reject")
                          :on-click (lambda () (a2ui-emacs--run-action surface c "rejectAction" scope))))
                      (when path
                        (vui-button "Ediff"
                          :key (concat key "/ediff")
                          :help-echo "Compare the file with the change in Ediff; edits you make there are kept"
                          :on-click (lambda () (a2ui-emacs-diff-ediff surface c scope))))
                      (when hunks
                        (vui-text (format "%d of %d hunks" (car hunks) (cdr hunks)) :face 'shadow))))))
    (when buttons (apply #'vui-hstack :spacing 2 buttons))))

(defun a2ui-emacs--diff-body (c surface scope diff)
  "Return the vnodes drawing DIFF for Diff C on SURFACE in SCOPE.
With a selection binding each hunk gets a toggle, and hunks left out
are dimmed.  Return (VNODES . HUNKS), HUNKS as for
`a2ui-emacs--diff-buttons'."
  ;; diff-mode fontifies a line once it ends.
  (let* ((lines (split-string (substring (a2ui-emacs-fontify (concat diff "\n") 'diff-mode) 0 -1) "\n"))
         (parsed (a2ui-emacs-diff-hunks diff))
         (count (length (cdr parsed)))
         (selected (a2ui-emacs--diff-selection c surface scope count)))
    (if (or (not (a2ui-binding-path c "selection" scope)) (zerop count))
        (cons (mapcar #'vui-text lines) nil)
      (let* ((key (a2ui-vui-key c scope))
             (path (a2ui-binding-path c "selection" scope))
             (out (reverse (mapcar #'vui-text (seq-take lines (length (car parsed))))))
             (rest (nthcdr (length (car parsed)) lines)))
        (cl-loop
         for hunk in (cdr parsed) for index from 0
         do (let* ((i index)
                   (on (memq i selected))
                   (shown (seq-take rest (length hunk))))
              (setq rest (nthcdr (length hunk) rest))
              (unless on
                (setq shown (mapcar (lambda (line)
                                      (let ((line (copy-sequence line)))
                                        (add-face-text-property 0 (length line) 'a2ui-emacs-hunk-off nil line)
                                        line))
                                    shown)))
              (push (vui-hstack
                     (vui-button (if on "[X]" "[ ]")
                       :key (format "%s/hunk/%d" key i)
                       :no-decoration t
                       :help-echo "Include or leave out this hunk"
                       :on-click (lambda ()
                                   (a2ui-vui--write
                                    surface path
                                    (vconcat (sort (if on (remq i selected) (cons i (copy-sequence selected)))
                                                   #'<)))))
                     (vui-text (car shown)))
                    out)
              (dolist (line (cdr shown)) (push (vui-text line) out))))
        (cons (nreverse out) (cons (length selected) count))))))

(a2ui-define-component emacs "Diff" (c surface scope)
  (let* ((file (a2ui-vui--string c "file" surface scope))
         (edited (when-let* ((p (a2ui-binding-path c "edited" scope))) (a2ui-stringify (a2ui-get surface p))))
         (diff (string-trim-right (if (and edited (not (string-empty-p edited)))
                                      edited
                                    (a2ui-vui--string c "diff" surface scope))))
         (body (unless (string-empty-p diff) (a2ui-emacs--diff-body c surface scope diff))))
    (apply #'vui-vstack
           (delq nil
                 (append
                  (list (unless (string-empty-p file) (vui-text file :face 'a2ui-emacs-file))
                        (when (and edited (not (string-empty-p edited)))
                          (vui-text "Edited by you in Ediff" :face 'a2ui-tone-warning)))
                  (if body (car body) (list (vui-text "(no changes)" :face 'shadow)))
                  (list (a2ui-emacs--diff-buttons c surface scope
                                                  (a2ui-emacs--diff-file surface file)
                                                  (cdr body))))))))

;;;;; Ediff

(defvar ediff-quit-hook)
(declare-function ediff-buffers "ediff" (buffer-a buffer-b &optional startup-hooks job-name))

(defun a2ui-emacs--file-mode (file)
  "Return the major mode for FILE when it is one to trust, or nil."
  (let ((mode (assoc-default file auto-mode-alist #'string-match)))
    (when (and (symbolp mode) (fboundp mode)
               (seq-some (lambda (parent) (provided-mode-derived-p mode parent))
                         '(prog-mode text-mode conf-mode)))
      mode)))

(defun a2ui-emacs--ediff-buffer (name text file &optional read-only)
  "Return a new buffer NAME holding TEXT in FILE's major mode.
Mode hooks are not run.  READ-ONLY makes it so."
  (let ((buffer (generate-new-buffer name)))
    (with-current-buffer buffer
      (insert text)
      (when-let* ((mode (a2ui-emacs--file-mode file)))
        (delay-mode-hooks (funcall mode)))
      (set-buffer-modified-p nil)
      (setq buffer-read-only read-only)
      (goto-char (point-min)))
    buffer))

(defun a2ui-emacs-diff-edited (surface path original edited file)
  "Write the change from ORIGINAL to EDITED of FILE to SURFACE at PATH.
Return the diff written."
  (let ((diff (a2ui-emacs-unified-diff original edited file)))
    (a2ui-vui--write surface path diff)
    diff))

(defun a2ui-emacs-diff-ediff (surface c scope)
  "Compare Diff C's file with its change in Ediff, on SURFACE in SCOPE.
The selected hunks (and an earlier edit) are applied to a copy of the
file; the file itself is never changed.  When the Diff binds `edited',
edits to the copy are written there as a diff when Ediff quits."
  (require 'ediff)
  (let* ((file (a2ui-vui--string c "file" surface scope))
         (path (or (a2ui-emacs--diff-file surface file)
                   (user-error "No file %s to compare with" file)))
         (edited-path (a2ui-binding-path c "edited" scope))
         (edited (and edited-path (a2ui-stringify (a2ui-get surface edited-path))))
         (diff (a2ui-vui--string c "diff" surface scope))
         (original (with-temp-buffer (insert-file-contents path) (buffer-string)))
         (proposed (condition-case err
                       (if (and edited (not (string-empty-p edited)))
                           (a2ui-emacs-diff-apply original edited)
                         (a2ui-emacs-diff-apply original diff
                                                (a2ui-emacs--diff-selection
                                                 c surface scope (length (cdr (a2ui-emacs-diff-hunks diff))))))
                     (a2ui-error (user-error "Cannot show the change: %s" (error-message-string err)))))
         (a (a2ui-emacs--ediff-buffer (format "*a2ui %s (now)*" file) original path t))
         (b (a2ui-emacs--ediff-buffer (format "*a2ui %s (proposed)*" file) proposed path)))
    (ediff-buffers
     a b
     (list (lambda ()
             (add-hook 'ediff-quit-hook
                       (lambda ()
                         (when (buffer-live-p b)
                           (let ((now (with-current-buffer b (buffer-string))))
                             (cond ((equal now proposed))
                                   (edited-path
                                    (a2ui-emacs-diff-edited surface edited-path original now file)
                                    (message "a2ui: your edit is in the surface; Accept sends it"))
                                   (t (message "a2ui: this Diff keeps no edits; yours were dropped")))))
                         (dolist (buffer (list a b))
                           (when (buffer-live-p buffer) (kill-buffer buffer))))
                       nil t))))))

(a2ui-define-component emacs "Code" (c surface scope)
  (let ((text (string-trim-right (a2ui-vui--string c "text" surface scope) "\n+")))
    (a2ui-vui--lines (a2ui-emacs-fontify text (a2ui-emacs--mode-for (gethash "language" c))))))

(a2ui-define-component emacs "Progress" (c surface scope)
  (let* ((value (or (a2ui-emacs--number-prop c "value" surface scope) 0))
         (fraction (a2ui-emacs--fraction value
                                         (or (a2ui-emacs--number-prop c "min" surface scope) 0)
                                         (or (a2ui-emacs--number-prop c "max" surface scope) 1))))
    (a2ui-emacs--gauge-line c surface scope
                            (a2ui-emacs-bar fraction a2ui-emacs-bar-width (a2ui-emacs--tone c surface scope))
                            (format "%d%%" (round (* 100 fraction))))))

(a2ui-define-component emacs "Sparkline" (c surface scope)
  (let ((values (a2ui-resolve-prop c "values" surface scope)))
    (a2ui-emacs--gauge-line c surface scope
                            (a2ui-emacs-sparkline (if (vectorp values) values [])
                                                  (a2ui-emacs--number-prop c "min" surface scope)
                                                  (a2ui-emacs--number-prop c "max" surface scope)
                                                  (a2ui-emacs--tone c surface scope))
                            "")))

(declare-function org-mode "org" ())

(a2ui-define-component emacs "OrgText" (c surface scope)
  (let ((text (string-trim-right (a2ui-vui--string c "text" surface scope) "\n+")))
    (require 'org)
    (a2ui-vui--lines
     (a2ui-emacs-fontify text #'org-mode
                         #'a2ui-emacs--org-setup t))))

(defvar org-hide-emphasis-markers)
(defvar org-link-descriptive)

(defun a2ui-emacs--org-setup ()
  "Hide Org markup, so that stripping invisible text leaves the prose."
  (setq-local org-hide-emphasis-markers t)
  (setq-local org-link-descriptive t))

(defun a2ui-emacs--options (value)
  "Return Picker options from VALUE as a list of (VALUE . LABEL)."
  (cl-loop for o across (if (vectorp value) value [])
           collect (if (hash-table-p o)
                       (cons (a2ui-stringify (gethash "value" o))
                             (a2ui-stringify (or (gethash "label" o) (gethash "value" o))))
                     (cons (a2ui-stringify o) (a2ui-stringify o)))))

(a2ui-define-component emacs "Picker" (c surface scope)
  (let* ((path (a2ui-binding-path c "value" scope))
         (label (a2ui-vui--string c "label" surface scope))
         (value (a2ui-resolve-prop c "value" surface scope)))
    (a2ui-vui--input
     c surface scope
     (vui-hstack
      (a2ui-vui--label-prefix c surface scope)
      (vui-select :key (a2ui-vui-key c scope)
                  :value (and value (a2ui-stringify value))
                  :options (a2ui-emacs--options (a2ui-resolve-prop c "options" surface scope))
                  :prompt (format "%s: " (if (string-empty-p label) "Choose" label))
                  :on-change (lambda (v) (a2ui-vui--write surface path v)))))))

(defun a2ui-emacs-visit (surface file line)
  "Visit FILE of SURFACE's session in another window, at LINE if given.
A relative FILE starts at the session's directory."
  (let ((path (expand-file-name file (or (a2ui-session-directory (a2ui-surface-session surface))
                                         default-directory))))
    (if (not (file-exists-p path))
        (message "a2ui: no such file %s" path)
      (pop-to-buffer (find-file-noselect path) '(display-buffer-use-some-window))
      (when (and (numberp line) (> line 0))
        (goto-char (point-min))
        (forward-line (1- (truncate line)))))))

(a2ui-define-component emacs "FileRef" (c surface scope)
  (let* ((file (a2ui-vui--string c "path" surface scope))
         (line (a2ui-number (a2ui-resolve-prop c "line" surface scope)))
         (label (a2ui-vui--string c "label" surface scope)))
    (vui-button (cond ((not (string-empty-p label)) label)
                      (line (format "%s:%d" file line))
                      (t file))
      :key (a2ui-vui-key c scope)
      :no-decoration t
      :face 'a2ui-link
      :help-echo (format "Visit %s" file)
      :on-click (lambda () (a2ui-emacs-visit surface file line)))))

;;;; Registration

(a2ui-register-catalog 'emacs
                       :id a2ui-emacs-catalog-id
                       :parent 'basic
                       :schema (expand-file-name "catalogs/emacs/catalog.json" a2ui--directory))

(add-to-list 'a2ui-default-catalogs 'emacs t)

(provide 'a2ui-emacs)
