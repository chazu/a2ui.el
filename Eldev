; -*- mode: emacs-lisp; lexical-binding: t -*-

(eldev-use-package-archive 'gnu-elpa)
(eldev-use-package-archive 'melpa-unstable)

(setf eldev-project-main-file "a2ui.el")

;; The catalog schemas ship with the package; the core reads them to
;; validate components.  Benchmarks, example agents and scripts don't.
(setf eldev-files-to-package
      `(:and (:or ,eldev-files-to-package "catalogs/")
             (:not ("./benchmarks/" "./examples/" "./scripts/"))))

(eldev-add-loading-roots 'test "test")

;; The gptel adapter is tested against the real gptel.
(eldev-add-extra-dependencies 'test 'gptel)

(setf eldev-lint-default '(package))
